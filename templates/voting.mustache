<div class="ranking-section hidden-print noprint">
	<div class="header">{{ section-title }}</div>
	<div class="content">
		<div class="buttons">
			<button class="btn btn-secondary ranking-btn yes" title="{{ yes }}">{{ yes }}</button>
			<button class="btn btn-secondary ranking-btn no" title="{{ no }}">{{ no }}</button>
		</div>
		<div class="voting-messages"></div>
		{{#is-captcha-enabled}}
			<div class="cf-turnstile"
				 data-sitekey="{{ siteKey }}"
				 data-cdata="articleranking"
				 data-language="{{ language }}"
				 data-execution="execute"
				 data-appearance="interaction-only"
				 data-callback="verifyRankingCaptcha"
				 data-error-callback="handleRankingCaptchaError"
				 data-expired-callback="handleRankingCaptchaError"
				 data-timeout-callback="handleRankingCaptchaError"
			></div>
		{{/is-captcha-enabled}}
	</div>
</div>
